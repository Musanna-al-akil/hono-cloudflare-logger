{
  "name": "hono-cloudflare-logger",
  "version": "0.2.0-beta.0",
  "description": "cloudflare-workers first structured logging middleware for Hono.",
  "keywords": [
    "cloudflare-log",
    "cloudflare-logger",
    "cloudflare-workers",
    "hono",
    "hono-logger",
    "logger",
    "middleware",
    "ndjson",
    "structured-logging",
    "syslog"
  ],
  "homepage": "https://github.com/Musanna-al-akil/hono-cloudflare-logger#readme",
  "bugs": {
    "url": "https://github.com/Musanna-al-akil/hono-cloudflare-logger/issues"
  },
  "license": "MIT",
  "author": "musanna-al-akil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Musanna-al-akil/hono-cloudflare-logger.git"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "bench:workerd": "node bench/workerd/run.mjs",
    "bench:baseline": "vitest bench --run --outputJson bench/results/node.baseline.json && node scripts/bench-normalize.mjs bench/results/node.baseline.json && node bench/workerd/run.mjs --out baseline",
    "bench:compare": "vitest bench --run --compare bench/results/node.baseline.json --outputJson bench/results/node.after.json && node scripts/bench-normalize.mjs bench/results/node.after.json && node bench/workerd/run.mjs --out after && node scripts/bench-report.mjs",
    "bench:report": "node scripts/bench-report.mjs",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run format:check && npm run typecheck && oxlint . --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "pack:dry-run": "env npm_config_cache=/tmp/npm-cache npm pack --dry-run",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check:jsr": "node scripts/check-jsr.mjs && npx -y jsr publish --dry-run --allow-dirty",
    "prepublish:check": "npm run lint && npm run test && npm run test:workers && npm run build && npm run size && npm run check:package && npm run pack:dry-run",
    "prepublishOnly": "npm run prepublish:check",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-jsr-version.mjs && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vitest-plugin": "^1.2.7",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "hono": "^4.13.9",
    "miniflare": "^4.20260730.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "hono": "^4.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
